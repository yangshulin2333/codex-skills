      "timeoutSeconds": 30,
      "maxAttempts": 3,
      "maxAssetBytes": null,
      "useAccountCredentials": false
    },
    "terrain": {
      "captureRaw": true,
      "bounds": null,
      "resolution": null,
      "chunkSize": null,
      "restoreInStudio": false
    },
    "optional": {
      "nativeConversion": false,
      "sourceRecovery": false,
      "staticPreview": false,
      "playPreview": false
    },
    "artifactIndexRelativePath": "artifact-index.json",
    "checkpointRelativePath": "checkpoint.json"
