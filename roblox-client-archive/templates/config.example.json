{
  "schemaVersion": 1,
  "environment": {
    "pathBase": "workflowRoot",
    "paths": {
      "artifactRoot": null,
      "xenoRoot": null,
      "xenoWorkspace": null,
      "playerExecutable": null,
      "studioExecutable": null,
      "pythonExecutable": null,
      "luneExecutable": null
    },
    "discovery": {
      "useCurrentUserEnvironment": true,
      "additionalInstallRoots": []
    }
  },
  "run": {
    "mode": "raw_archive",
    "identity": {
      "gameName": null,
      "expectedPlaceId": null,
      "expectedUniverseId": null,
      "captureId": null,
      "sceneLabel": null,
      "floorOrRound": null
    },
    "versions": {
      "player": null,
      "playerVersionHash": null,
      "xeno": null,
      "engine": null,
      "apiDump": null
    },
    "paths": {
      "captureRelativeDir": "captures/{captureId}",
      "packageRelativeDir": "packages/{captureId}",
      "derivedRelativeDir": "derived/{captureId}/{derivedId}"
    },
    "derivedId": null,
    "inputArchiveArtifactId": null,
    "inputs": {
      "exporterOriginal": null,
      "exporterReviewed": null,
      "fullApiDump": null,
      "captureEntrypoint": null,
      "downloadEntrypoint": null,
      "verificationEntrypoint": null,
      "sourceRecoveryEntrypoint": null
